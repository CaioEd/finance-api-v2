# Copie para .env e ajuste. Nenhum destes valores tem default no código:
# ENVIRONMENT, APP_TIMEZONE, DATABASE_URL e JWT_SECRET_KEY são obrigatórios e a
# aplicação recusa subir sem eles.

# Aplicação
ENVIRONMENT=local            # local | test | staging | production
APP_TIMEZONE=America/Sao_Paulo   # fuso em que "hoje" e "mês corrente" são resolvidos
DEBUG=true                   # precisa ser false quando ENVIRONMENT=production
DOCS_ENABLED=true            # /docs, /redoc e /openapi.json
APP_NAME=finance-api

# HTTP
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

# Banco
# Rodando na máquina: host localhost. Rodando via compose: o serviço `api`
# sobrescreve esta variável para apontar em `db`.
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Autenticação
# Gere a sua e NUNCA reuse este exemplo:  openssl rand -base64 48
# Mínimo de 32 caracteres. Trocar a chave invalida todos os access tokens em
# circulação (os refresh tokens continuam válidos: eles vivem no banco).
JWT_SECRET_KEY=troque-esta-chave-de-exemplo-por-uma-gerada-de-verdade
ACCESS_TOKEN_TTL_SECONDS=900     # 15 min; access token não é revogável
REFRESH_TOKEN_TTL_DAYS=30
# Custo do argon2id. Baixe apenas em ambiente de teste.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Testes 
# Consumido só pela suíte (tests/conftest.py), nunca pela aplicação.
TEST_DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5433/finance_test

# Compose
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
API_PORT=8000
